<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PatologiaFacil" parent="Theme.Material3.Light.NoActionBar">
        <!-- Core brand palette (fixed light theme) -->
        <item name="colorPrimary">@color/pf_primary</item>
        <item name="colorOnPrimary">@color/pf_onPrimary</item>
        <item name="colorPrimaryContainer">@color/pf_primaryContainer</item>
        <item name="colorSecondary">@color/pf_primaryContainer</item>
        <item name="colorOnSecondary">@color/pf_onPrimary</item>

        <item name="android:statusBarColor">@color/pf_primary</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/pf_bg</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>

        <!-- Surfaces / text -->
        <item name="colorSurface">@color/pf_surface</item>
        <item name="colorOnSurface">@color/pf_onSurface</item>
        <item name="colorOnSurfaceVariant">@color/pf_onSurfaceVariant</item>
        <item name="colorOutline">@color/pf_divider</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/pf_onPrimary</item>

        <!-- Typography -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.PF.HeadlineLarge</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.PF.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.PF.TitleMedium</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.PF.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.PF.BodyMedium</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.PF.LabelLarge</item>

        <!-- Component styles -->
        <item name="materialButtonStyle">@style/Widget.PF.Button.Filled</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.PF.Button.Outlined</item>
        <item name="bottomNavigationStyle">@style/Widget.MaterialComponents.BottomNavigationView</item>
        <item name="colorControlHighlight">@color/brandPrimaryDark</item>

        <item name="android:textColorPrimary">@color/pf_black_soft</item>
        <item name="android:textColorSecondary">@color/pf_gray_medium</item>

        <!-- Apply default EditText padding/height fix globally -->
        <item name="android:editTextStyle">@style/Widget.PF.EditText.FixClipping</item>
        <item name="editTextStyle">@style/Widget.PF.EditText.FixClipping</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.PF.Button.Filled" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/pf_primary</item>
        <item name="android:textColor">@color/pf_onPrimary</item>
        <item name="cornerRadius">@dimen/corner_button</item>
        <item name="rippleColor">@color/pf_ripple_on_primary</item>
    </style>

    <style name="Widget.PF.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/pf_primary</item>
        <item name="android:textColor">@color/pf_primary</item>
        <item name="cornerRadius">@dimen/corner_button</item>
        <item name="rippleColor">@color/pf_ripple_light</item>
    </style>

    <style name="Widget.PF.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/pf_ripple_light</item>
        <item name="android:textColor">@color/pf_primary</item>
        <item name="cornerRadius">@dimen/corner_button</item>
    </style>

    <!-- Bottom Navigation -->
    <style name="Widget.PF.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@color/pf_bottom_nav_item</item>
        <item name="itemTextColor">@color/pf_bottom_nav_item</item>
        <item name="itemRippleColor">@color/brandPrimaryDark</item>
        <item name="android:background">@drawable/bottom_nav_background</item>
    </style>
</resources>
