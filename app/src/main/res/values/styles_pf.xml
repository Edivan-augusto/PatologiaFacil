<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- BotÃ£o primÃ¡rio -->
    <style name="Widget.PF.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@drawable/pf_btn_primary</item>
        <item name="android:textColor">@color/pf_white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- BotÃ£o outline -->
    <style name="Widget.PF.Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@drawable/pf_btn_outline</item>
        <item name="android:textColor">@color/pf_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Input -->
    <style name="Widget.PF.Input" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:background">@drawable/pf_input_bg</item>
        <item name="android:padding">0dp</item>
        <item name="android:textColorHint">@color/pf_gray_medium</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- EditText default fix to avoid top clipping of glyphs -->
    <style name="Widget.PF.EditText.FixClipping" parent="Widget.AppCompat.EditText">
        <item name="android:includeFontPadding">true</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <!-- Badge -->
    <style name="Widget.PF.Badge">
        <item name="android:textColor">@color/pf_white</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
    </style>

    <!-- ===================== -->
    <!-- Fix para referÃªncias  -->
    <!-- ===================== -->

    <!-- Resolve o erro: style/Widget not found -->
    <style name="Widget" parent="android:Widget"/>

    <!-- Base PF namespace -->
    <style name="Widget.PF"/>

    <!-- Aliases para compatibilidade -->


</resources>
