    <dimen name="shape_large">28dp</dimen>

    <style name="ShapeAppearance.PatologiaFacil.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/shape_small</item>
    </style>

    <style name="ShapeAppearance.PatologiaFacil.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/shape_medium</item>
    </style>

    <style name="ShapeAppearance.PatologiaFacil.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/shape_large</item>
    </style>
</resources>
